# Optional overrides for local docker compose; no copy is needed for default startup.
# Synthetic local credentials only. Production uses .env.production.example.
APP_PORT=8080
MAILPIT_PORT=8025
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=taskforge
REDIS_PASSWORD=local-redis-only
JWT_SECRET=local-only-secret-at-least-32-characters
FRONTEND_URL=http://localhost:8080
# Blank public build-time origins use the browser origin through Nginx.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
