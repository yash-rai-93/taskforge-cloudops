# Production topology: supply three published application images and private secrets.
# The release pipeline publishes images; AWS provisioning and HTTPS need setup.
# Copy to .env.production, chmod 600, and fill blanks privately.
HTTP_PORT=127.0.0.1:8080
IMAGE_NAMESPACE=ghcr.io/yash-rai-93/taskforge-cloudops
# Full 40-character lowercase commit SHAs, independently selectable per service.
# The release bundle supplies these values and overrides all app images by digest.
API_IMAGE_TAG=
WORKER_IMAGE_TAG=
FRONTEND_IMAGE_TAG=

# Runtime: Ubuntu EC2 -> Compose internal PostgreSQL / Redis.
# Compose fixes NODE_ENV=production and API PORT=3000.
# DB_HOST=postgres and DB_PORT=5432 are fixed by production Compose.
DB_NAME=taskforge
DB_USERNAME=taskforge
DB_PASSWORD=
# Internal PostgreSQL uses DB_SSL=false; certificate verification stays enabled
# if a future external TLS endpoint is deliberately introduced.
# REDIS_HOST=redis and REDIS_PORT=6379 are fixed by production Compose.
# Required for both the Redis server and its API/worker clients.
REDIS_PASSWORD=
# Internal Redis is plaintext on the private Compose network; no TLS endpoint.
# REDIS_TLS=false is fixed by production Compose.

# Generate a unique JWT secret of at least 32 characters; no shipped fallback.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Public origin, no trailing slash. Required for verification emails / redirects.
FRONTEND_URL=

# PUBLIC BUILD-TIME values: never put secrets here. Rebuild frontend to change.
# Leave blank for same-origin Nginx routing (recommended).
# Explicit origins require rebuilding the frontend image; no path suffixes.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# Optional: both values are displayed publicly on /login. Use only a verified
# account in a disposable workspace with sample data. Leave blank to hide it.
PUBLIC_DEMO_EMAIL=
PUBLIC_DEMO_PASSWORD=

# Stripe disabled when empty; paid billing endpoints will be unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# SMTP delivery disabled by default. Set true and configure your own provider.
# No local Mailpit inbox exists in production. Startup can succeed,
# but public signup verification / reset / invite email delivery needs SMTP.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskForge <noreply@example.com>

# AWS region, EC2 host, instance type, security groups, DNS, IAM and costs
# are deployment inputs, not application variables. See the audit document.
# No AWS credentials belong in this file or the application containers.
