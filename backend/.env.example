# Development only: run Node on the host, with PostgreSQL / Redis on loopback.
# Start support services with docker-compose.dev.yml; see docs/CONTAINERS.md.
PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Synthetic local credential matching docker-compose.yml; never use in production.
DB_PASSWORD=postgres
DB_NAME=taskforge
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-only
REDIS_TLS=false
# Synthetic local-only value; generate a different secret for any deployment.
JWT_SECRET=local-development-only-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
FRONTEND_URL=http://localhost:3001

# Optional Stripe: leave empty to disable paid billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
# Optional SMTP: startup works without it; verification emails will not be sent.
# Do not expose email preview logs (they can contain verification/reset tokens).
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskForge <noreply@example.com>
