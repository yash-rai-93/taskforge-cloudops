# Public build-time configuration: these values are embedded in browser JS.
# Base origin only; the API client appends /api/v1 and Socket.IO uses /socket.io.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# Production: use your own HTTPS public origin for BOTH, then rebuild.
# Empty/unset values use the browser origin (default for Docker via Nginx).
# Never place passwords, tokens, AWS keys, or other secrets in NEXT_PUBLIC_*.
